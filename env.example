# Copy this file to .env for local reference, or set these as environment
# variables / secrets directly on your hosting platform. NEVER commit a
# real .env file — it's already in .gitignore.

# Required: get a free key from https://cricketdata.org
CRICKET_API_KEY=your-real-api-key-here

# Optional: track a specific match instead of auto-finding a live IPL match
MATCH_ID=

# Optional: comma-separated list of allowed frontend origins for CORS.
# Leave unset ("*") for local dev. Set explicitly in production, e.g.:
# ALLOWED_ORIGINS=https://your-deployed-app.onrender.com
ALLOWED_ORIGINS=*

# Optional: path to the SQLite database file
DB_PATH=ipl_scores.db

# Optional: set to 1 for verbose debug logging
DEBUG=0
